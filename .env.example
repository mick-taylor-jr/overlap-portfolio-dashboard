# All optional. With none set, the app runs in seed-data mode.
# Alpha Vantage free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Daily request budget the app allows itself (free tier is tiny; check current docs)
ALPHA_VANTAGE_DAILY_BUDGET=25
# CoinGecko Demo key (sent as x-cg-demo-api-key): https://www.coingecko.com/en/api/pricing
COINGECKO_DEMO_API_KEY=
# Upstash Redis (Vercel Marketplace injects these automatically)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Protects /api/cron/warm (Vercel Cron sends this as a Bearer token)
CRON_SECRET=
